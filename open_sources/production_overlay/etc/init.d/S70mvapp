#!/bin/sh
# Start mvapp (CBS production overlay — v39 template had this commented out).
start() {
  echo "Starting mvapp..."
  export LD_LIBRARY_PATH=/lib:/usr/lib:/usr/work0/lib
  export SDL_NOMOUSE=1
  /usr/work0/app/mvapp.elf &
}
stop() {
  echo -n "Stopping MVAPP..."
  killall mvapp.elf 2>/dev/null || killall mvapp 2>/dev/null || true
}
restart() {
  stop
  start
}
case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) restart ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
